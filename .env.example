FIREBASE_PROJECT_ID=capacitaciones-api
# Opción sencilla y compatible con macOS y Windows:
# guarda el JSON como backend/firebase-service-account.json. RunSQL lo detecta
# automáticamente y no necesitas definir FIREBASE_SERVICE_ACCOUNT.

# Ruta absoluta al JSON descargado desde Firebase Console > Configuración del
# proyecto > Cuentas de servicio. No agregues ese JSON al repositorio.
# macOS:
# FIREBASE_SERVICE_ACCOUNT=/Users/tu_usuario/.config/runsql/firebase-service-account.json
# Windows:
# FIREBASE_SERVICE_ACCOUNT=C:\Users\tu.usuario\Documents\firebase-service-account.json
